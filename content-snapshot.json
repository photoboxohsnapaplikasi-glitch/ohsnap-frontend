    "home": {
      "subEn": " Trendy Photobox Studio.",
      "subId": "Photobox & Self-Photo Studio kekinian.",
      "imgUrl": "https://kbkayevpbeijuuufnrgt.supabase.co/storage/v1/object/public/ohsnap-media/img/1794195094153-xhfcnpwy.jpg",
      "titleEn": "PRINT ON THE SPOT AND TAKE IT HOME",
      "titleId": "LANGSUNG CETAK DAN BAWA PULANG",
